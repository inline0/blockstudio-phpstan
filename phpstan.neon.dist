includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon
  # Dogfood the rules this package ships to consumers.
  - extension.neon

parameters:
  # Keep deliberately invalid fixtures out of the rules' schema discovery.
  blockstudioExcludePaths:
    - tests/**
    - vendor/**
  level: 8
  paths:
    - src

  excludePaths:
    - src/Stubs/*
    # Fixture projects: deliberately malformed input the rules are tested against.
    - tests/data/*
    - tests/Rules/data/*
    - tests/Unit/data/*
  bootstrapFiles:
    - src/Stubs/loader.php
